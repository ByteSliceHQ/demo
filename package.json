{
  "name": "demo-todo",
  "version": "1.0.0",
  "private": true,
  "description": "A simple todo app styled with Tailwind CSS",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./dist/output.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "start": "node server.js"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
